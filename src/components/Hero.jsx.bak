import React from "react";
import styled, { keyframes } from "styled-components";
import { motion } from "framer-motion";
import { FaGithub, FaLinkedin, FaInstagram, FaEnvelope, FaWhatsapp } from "react-icons/fa";

/* ------------------ ANIMATIONS ------------------ */

// Floating icons
const float = keyframes`
  0% { transform: translateY(0); }
  50% { transform: translateY(-6px); }
  100% { transform: translateY(0); }
`;

// Each letter color animation
const letterColorCycle = keyframes`
  0% { color: #ff0040; }
  15% { color: #ff8c00; }
  30% { color: #ffee00; }
  45% { color: #32ff7e; }
  60% { color: #00eaff; }
  75% { color: #8f00ff; }
  100% { color: #ff0040; }
`;

/* Glow bar */
const glowPulse = keyframes`
  0% { opacity: 0.5; transform: scale(1); }
  50% { opacity: 1; transform: scale(1.08); }
  100% { opacity: 0.5; transform: scale(1); }
`;

/* Particle float */
const particleFloat = keyframes`
  0% { transform: translateY(0) rotate(0); opacity: 0.4; }
  50% { opacity: 1; }
  100% { transform: translateY(-120px) rotate(360deg); opacity: 0; }
`;

/* ------------------ HERO SECTION ------------------ */

const HeroSection = styled.section`
  height: 100vh;
  width: 100%;
  background: linear-gradient(135deg, #0b1721, #071a29);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  position: relative;
  overflow: hidden;
  color: #fff;
  padding: 0 1rem;

  @media (max-width: 480px) {
    padding: 0 0.6rem;
  }
`;

/* ------------------ PARTICLES ------------------ */

const Particle = styled.div`
  position: absolute;
  border-radius: 50%;
  background: rgba(0, 255, 255, 0.45);
  width: ${(p) => p.size}px;
  height: ${(p) => p.size}px;
  top: ${(p) => p.top}%;
  left: ${(p) => p.left}%;
  animation: ${particleFloat} ${(p) => p.duration}s linear infinite;

  @media (max-width: 480px) {
    width: ${(p) => p.size * 0.6}px;
    height: ${(p) => p.size * 0.6}px;
  }
`;

/* ------------------ TITLE ------------------ */

const TitleWrapper = styled.div`
  display: flex;
  flex-direction: column;
  align-items: center;
`;

const Line = styled.h1`
  font-size: 3rem;
  font-weight: 800;
  margin: 0.2rem 0;
  display: flex;

  span {
    margin: 0 2px;
    display: inline-block;
    cursor: pointer;
    animation: ${letterColorCycle} 2.5s linear infinite;
    animation-delay: ${(props) => props.delay}s;

    &:hover {
      transform: translateY(-10px) scale(1.25);
      transition: 0.3s;
    }
  }

  @media (max-width: 768px) {
    font-size: 2.2rem;
  }
  @media (max-width: 480px) {
    font-size: 1.6rem;
    span {
      margin: 0 1px;
    }
  }
`;

/* Glow bar */
const GlowBar = styled.div`
  width: 150px;
  height: 8px;
  margin-top: 6px;
  background: radial-gradient(circle, #00eaff, transparent);
  border-radius: 12px;
  filter: blur(5px);
  animation: ${glowPulse} 2.5s infinite;

  @media (max-width: 480px) {
    width: 100px;
  }
`;

/* ------------------ SUBTITLE ------------------ */

const Subtitle = styled(motion.h2)`
  margin-top: 0.7rem;
  font-size: 1.3rem;
  color: #cfffff;

  @media (max-width: 480px) {
    font-size: 1rem;
  }
`;

/* ------------------ DESCRIPTION ------------------ */

const Description = styled(motion.p)`
  font-size: 1rem;
  color: #d7f7ff;
  max-width: 650px;
  margin-top: 0.7rem;
  line-height: 1.6;

  @media (max-width: 480px) {
    font-size: 0.9rem;
  }
`;

/* ------------------ SOCIAL ICONS (NO BORDER BOX) ------------------ */

const SocialContainer = styled.div`
  margin-top: 1.8rem;
  display: flex;
  gap: 1.4rem;
  animation: ${float} 4s ease-in-out infinite;
`;

const IconLink = styled.a`
  font-size: 2rem;
  color: #00ffff;
  transition: 0.3s;

  &:hover {
    transform: scale(1.3);
    color: #ffd700;
  }

  @media (max-width: 480px) {
    font-size: 1.5rem;
  }
`;

/* ------------------ COMPONENT ------------------ */

export default function Hero() {
  const name = "Kuncham Venkatesh";

  return (
    <HeroSection id="home">
      {[...Array(15)].map((_, i) => (
        <Particle
          key={i}
          size={8 + Math.random() * 8}
          top={Math.random() * 100}
          left={Math.random() * 100}
          duration={3 + Math.random() * 4}
        />
      ))}

      <TitleWrapper>
        {/* Hello I'm */}
        <Line>
          {"Hello, I'm".split("").map((char, i) => (
            <span key={i} delay={i * 0.15}>{char}</span>
          ))}
        </Line>

        {/* Animated color changing name */}
        <Line>
          {name.split("").map((char, i) => (
            <span key={i} delay={i * 0.12}>{char}</span>
          ))}
        </Line>

        <GlowBar />
      </TitleWrapper>

      <Subtitle
        initial={{ opacity: 0, y: 40 }}
        animate={{ opacity: 1, y: 0 }}
        transition={{ duration: 1 }}
      >
        BCA Student | AI & Web Developer | Creative Innovator
      </Subtitle>

      <Description
        initial={{ opacity: 0 }}
        animate={{ opacity: 1 }}
        transition={{ delay: 0.4, duration: 1 }}
      >
        Passionate about building intelligent and interactive web applications. Skilled in React, Node.js, and AI integration, I love transforming ideas into visually appealing, high-performance solutions.
      </Description>

      <SocialContainer>
        <IconLink href="https://github.com/venkyaarm" target="_blank"><FaGithub /></IconLink>
        <IconLink href="https://linkedin.com/in/venkatesh-kuncham-120531307" target="_blank"><FaLinkedin /></IconLink>
        <IconLink href="https://instagram.com/venky__x8" target="_blank"><FaInstagram /></IconLink>
        <IconLink href="mailto:venkatesh.k@example.com"><FaEnvelope /></IconLink>
        <IconLink href="https://wa.me/918125522139" target="_blank"><FaWhatsapp /></IconLink>
      </SocialContainer>

    </HeroSection>
  );
}
