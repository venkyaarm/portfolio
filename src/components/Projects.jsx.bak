import React from "react";
import styled, { keyframes } from "styled-components";
import { motion } from "framer-motion";
import { FaGithub } from "react-icons/fa";

/* ------------------------------------------------------------ */
/*                 BEAUTIFUL TITLE SHINE ANIMATION              */
/* ------------------------------------------------------------ */

const titleShine = keyframes`
  0% { background-position: -200%; }
  100% { background-position: 200%; }
`;

/* ------------------------------------------------------------ */
/*                        HOVER GLOW                            */
/* ------------------------------------------------------------ */

const glow = keyframes`
  0% { box-shadow: 0 0 15px rgba(0,255,255,0.2); }
  50% { box-shadow: 0 0 25px rgba(0,255,255,0.5); }
  100% { box-shadow: 0 0 15px rgba(0,255,255,0.2); }
`;

/* ------------------------------------------------------------ */
/*                           SECTION                             */
/* ------------------------------------------------------------ */

const Section = styled.section`
  padding: 5rem 10%;
  background: linear-gradient(135deg, #061922, #0e3242, #144c63);
  color: #fff;

  h2 {
    text-align: center;
    font-size: 3rem;
    margin-bottom: 3rem;
    background: linear-gradient(90deg, #00ffff, white, #00ffff);
    -webkit-background-clip: text;
    color: transparent;
    background-size: 300%;
    animation: ${titleShine} 5s linear infinite;
  }

  @media (max-width: 480px) {
    padding: 3rem 1.2rem;

    h2 {
      font-size: 2rem;
    }
  }
`;

/* ------------------------------------------------------------ */
/*                          CARD                                 */
/* ------------------------------------------------------------ */

const Card = styled(motion.div)`
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(255,255,255,0.06);
  border-radius: 18px;
  overflow: hidden;
  margin-bottom: 2.5rem;
  border: 1px solid rgba(0,255,255,0.15);
  transition: 0.4s ease;
  position: relative;

  &:hover {
    transform: translateY(-8px) scale(1.02);
    animation: ${glow} 2s infinite ease-in-out;
    border-color: #00ffff;
  }

  @media (max-width: 768px) {
    flex-direction: column;
  }
`;

const CardContent = styled.div`
  padding: 2rem;
  flex: 1.2;

  h3 {
    font-size: 1.9rem;
    margin-bottom: 1rem;
    color: #ffcc00;
    text-shadow: 0 0 8px #ffcc00;
  }

  p {
    font-size: 1.05rem;
    line-height: 1.7;
    color: #d9f3f5;
    margin-bottom: 1.5rem;
  }

  .links {
    display: flex;
    align-items: center;
    gap: 1.2rem;
  }
`;

/* ------------------------------------------------------------ */
/*                       BUTTON + ICON                           */
/* ------------------------------------------------------------ */

const GithubLink = styled.a`
  font-size: 2rem;
  color: #00ffff;
  transition: 0.3s ease;

  &:hover {
    color: #ffcc00;
    transform: scale(1.15);
  }
`;

const ViewButton = styled.a`
  padding: 0.7rem 1.6rem;
  background: linear-gradient(135deg, #00ffff, #00bcd4);
  border-radius: 10px;
  color: #000;
  font-weight: 700;
  text-decoration: none;
  box-shadow: 0 4px 15px rgba(0,255,255,0.4);
  transition: 0.3s ease;

  &:hover {
    background: linear-gradient(135deg, #ffcc00, #ffaa00);
    transform: translateY(-3px);
    box-shadow: 0 4px 20px rgba(255,204,0,0.5);
  }
`;

/* ------------------------------------------------------------ */
/*                         PROJECT IMAGE                         */
/* ------------------------------------------------------------ */

const CardImage = styled.div`
  flex: 1;
  overflow: hidden;
  position: relative;

  img {
    width: 100%;
    height: 260px;
    object-fit: cover;
    transition: 0.5s ease;
  }

  ${Card}:hover img {
    transform: scale(1.15);
    filter: brightness(1.15) drop-shadow(0 0 10px #00ffff);
  }

  @media (max-width: 768px) {
    img {
      height: 220px;
    }
  }
`;

/* ------------------------------------------------------------ */
/*                         COMPONENT                             */
/* ------------------------------------------------------------ */

export default function Projects() {
  const fadeUp = {
    hidden: { opacity: 0, y: 80 },
    visible: (i) => ({
      opacity: 1,
      y: 0,
      transition: { delay: i * 0.15, duration: 0.8, ease: "easeOut" },
    }),
  };

  const projects = [
    {
      title: "AI Q&A App",
      desc: "An AI-powered real-time Q&A system with React and Gemini API, providing instant intelligent responses.",
      github: "https://github.com/venkyaarm/Venky-Q-and-A-app",
      demo: "https://venky-q-and-a-app.netlify.app/",
      image: "/projects/ai-qa.png",
    },
    {
      title: "PPT Generator",
      desc: "Generate AI-powered PPTs instantly with smart content, structured slides, and ready-to-present output.",
      github: "https://github.com/venkyaarm/Venkt-PPT",
      demo: "https://venky-ppt.netlify.app/",
      image: "/projects/ppt-generator.png",
    },
    {
      title: "QR Generator",
      desc: "Generate QR codes for URLs, text, and images with customizable designs and high-quality downloads.",
      github: "https://github.com/venkyaarm/venkyQR",
      demo: "https://venkyqr.netlify.app/",
      image: "/projects/qr-generator.png",
    },
    {
      title: "Resume App",
      desc: "AI-powered resume builder with automatic suggestions, job insights, and modern UX design.",
      github: "https://github.com/venkyaarm/venky-resume",
      demo: "https://venkyresumeapp.netlify.app/",
      image: "/projects/resume-app.png",
    },
    {
      title: "Wood Interior",
      desc: "Dynamic wooden interior shopping UI with admin panel, live product management, and responsive design.",
      github: "https://github.com/venkyaarm/wood-interior-website",
      demo: "https://woodeninterior.netlify.app/",
      image: "/projects/wood.png",
    },
    {
      title: "Image Puzzle",
      desc: "Interactive puzzle generator with drag-drop logic, custom puzzles, and engaging animations.",
      github: "https://github.com/venkyaarm/Venky-puzzle",
      demo: "https://venkypuzzle.netlify.app/",
      image: "/projects/puzzle.png",
    },
  ];

  return (
    <Section id="projects">
      <h2>Projects</h2>

      {projects.map((p, i) => (
        <Card
          key={i}
          custom={i}
          initial="hidden"
          whileInView="visible"
          variants={fadeUp}
          viewport={{ once: true, amount: 0.3 }}
        >
          <CardContent>
            <h3>{p.title}</h3>
            <p>{p.desc}</p>

            <div className="links">
              <GithubLink href={p.github} target="_blank">
                <FaGithub />
              </GithubLink>

              <ViewButton href={p.demo} target="_blank">
                View Project
              </ViewButton>
            </div>
          </CardContent>

          <CardImage>
            <img src={p.image} alt={p.title} />
          </CardImage>
        </Card>
      ))}
    </Section>
  );
}
