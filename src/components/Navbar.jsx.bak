import React, { useState } from "react";
import styled from "styled-components";
import { motion, AnimatePresence } from "framer-motion";
import { FaBars, FaTimes } from "react-icons/fa";

// ===================== MAIN NAV CONTAINER =====================
const Nav = styled.nav`
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1.2rem 6%;
  background: rgba(0, 0, 0, 0.45);
  backdrop-filter: blur(14px);
  position: sticky;
  top: 0;
  z-index: 200;
  border-bottom: 1px solid rgba(0, 255, 255, 0.2);
`;

// ===================== BRAND =====================
const Brand = styled.h1`
  font-size: 1.9rem;
  color: #00eaff;
  font-weight: 800;
  letter-spacing: 1.2px;
  cursor: pointer;
  transition: 0.3s ease;

  &:hover {
    color: #ffdd55;
    text-shadow: 0 0 10px #ffdd55;
  }
`;

// ===================== DESKTOP LINKS =====================
const Links = styled.div`
  display: flex;
  gap: 2.5rem;

  @media (max-width: 768px) {
    display: none;
  }
`;

const Link = styled.a`
  color: #ffffff;
  font-weight: 500;
  font-size: 1.1rem;
  text-decoration: none;
  position: relative;
  transition: 0.3s ease;

  &:hover {
    color: #00eaff;
  }

  &::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -6px;
    width: 0%;
    height: 2px;
    background: #00eaff;
    transition: width 0.3s ease;
  }

  &:hover::after {
    width: 100%;
  }
`;

// ===================== MOBILE MENU ICON =====================
const MenuIcon = styled.div`
  font-size: 2rem;
  color: #00eaff;
  cursor: pointer;
  transition: 0.3s ease;

  &:hover {
    transform: scale(1.15);
  }

  @media (min-width: 769px) {
    display: none;
  }
`;

// ===================== OVERLAY BACKDROP =====================
const Overlay = styled(motion.div)`
  position: fixed;
  top: 0;
  left: 0;
  height: 100vh;
  width: 100vw;
  background: rgba(0, 0, 0, 0.55);
  backdrop-filter: blur(4px);
  z-index: 150;
`;

// ===================== MOBILE MENU =====================
const MobileMenu = styled(motion.div)`
  position: fixed;
  top: 0;
  right: 0;
  height: 100vh;
  width: 75%;
  padding-top: 6rem;
  background: rgba(12, 27, 35, 0.95);
  backdrop-filter: blur(16px);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2.2rem;
  z-index: 200;
  box-shadow: -5px 0 20px rgba(0, 255, 255, 0.3);

  a {
    font-size: 1.4rem;
    color: #fff;
    text-decoration: none;
    font-weight: 600;
    letter-spacing: 1px;
    transition: 0.3s ease;

    &:hover {
      color: #00eaff;
      transform: translateX(8px);
    }
  }
`;

export default function Navbar() {
  const [isOpen, setIsOpen] = useState(false);

  return (
    <Nav>
      {/* Brand */}
      <motion.div initial={{ opacity: 0 }} animate={{ opacity: 1 }}>
        <Brand>Kuncham Venkatesh</Brand>
      </motion.div>

      {/* Desktop Links */}
      <Links>
        <Link href="#about">About</Link>
        <Link href="#skills">Skills</Link>
        <Link href="#projects">Projects</Link>
        <Link href="#contact">Contact</Link>
      </Links>

      {/* Hamburger Icon */}
      <MenuIcon onClick={() => setIsOpen(true)}>
        <FaBars />
      </MenuIcon>

      {/* Mobile Navigation */}
      <AnimatePresence>
        {isOpen && (
          <>
            {/* Background Overlay */}
            <Overlay
              initial={{ opacity: 0 }}
              animate={{ opacity: 1 }}
              exit={{ opacity: 0 }}
              onClick={() => setIsOpen(false)}
            />

            {/* Sidebar Menu */}
            <MobileMenu
              initial={{ x: "100%" }}
              animate={{ x: 0 }}
              exit={{ x: "100%" }}
              transition={{ duration: 0.35 }}
            >
              <FaTimes
                style={{
                  position: "absolute",
                  top: "20px",
                  right: "20px",
                  fontSize: "1.8rem",
                  color: "#00eaff",
                  cursor: "pointer",
                }}
                onClick={() => setIsOpen(false)}
              />

              <Link href="#about" onClick={() => setIsOpen(false)}>
                About
              </Link>
              <Link href="#skills" onClick={() => setIsOpen(false)}>
                Skills
              </Link>
              <Link href="#projects" onClick={() => setIsOpen(false)}>
                Projects
              </Link>
              <Link href="#contact" onClick={() => setIsOpen(false)}>
                Contact
              </Link>
            </MobileMenu>
          </>
        )}
      </AnimatePresence>
    </Nav>
  );
}
